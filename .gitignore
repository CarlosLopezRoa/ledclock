.venv/
__pycache__/
*.egg-info/

# Generated by tools/make_app_bundle.sh. All four embed absolute paths under
# the current user's home, and the bundles carry a copied interpreter binary.
/tools/LedClock.app/
/tools/LedClockMenu.app/
/bin/ledclock
/bin/ledclock-menu

# Rendered previews. Harmless-looking, but they are pictures of the real
# panel: your temperature, your place name, your local time.
/preview/

# Your own settings: home coordinates to the metre, the panel's address, and
# whichever cities you happen to care about. Copy config.example.yaml instead.
/config.yaml
